@model List<HelpDesk.Mvc.Models.Ticket>

<h2>All Tickets</h2>

<div class="mb-3">
    <a asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
    <a asp-action="Create" class="btn btn-success">Raise New Ticket</a>
    <a asp-action="FilterByStatus" class="btn btn-info">Filter by Status</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Raised By</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.Priority</td>
                <td>@ticket.Status</td>
                <td>@ticket.RaisedBy</td>
                <td>@ticket.CreatedDate</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@ticket.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>